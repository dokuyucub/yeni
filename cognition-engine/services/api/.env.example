# =============================================================================
# Cognition Engine API Service - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# Server Configuration
# =============================================================================
HOST=0.0.0.0
PORT=8000
ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# =============================================================================
# Supabase Configuration
# =============================================================================
# For LOCAL development with Supabase CLI:
#   Run: cd infra/supabase && supabase start
#   Then: supabase status (to get the values below)
#
# Local defaults (from supabase start):
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# JWT Secret for offline token verification
# Get from: supabase status (look for "JWT secret")
# Local default:
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# For PRODUCTION (Supabase hosted):
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-production-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key
# SUPABASE_JWT_SECRET=your-production-jwt-secret (from Supabase dashboard > Settings > API)

# =============================================================================
# Anthropic (Claude) API
# =============================================================================
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=10

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins
# Include Expo dev server URLs
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081,http://127.0.0.1:19006

# =============================================================================
# Security
# =============================================================================
# Used for additional application-level security (session signing, etc.)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production

# =============================================================================
# SECURITY NOTES
# =============================================================================
# - SUPABASE_SERVICE_ROLE_KEY bypasses RLS - use only for admin operations
# - SUPABASE_JWT_SECRET is used to verify JWTs offline (faster than API call)
# - Never expose SERVICE_ROLE_KEY or JWT_SECRET to clients
# - In production, rotate keys periodically
# - ANTHROPIC_API_KEY should have usage limits set in the Anthropic console
