# =============================================================================
# Cognition Engine Mobile App - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# API Configuration
# =============================================================================
# Backend API URL (FastAPI service)
EXPO_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# Supabase Configuration
# =============================================================================
# For LOCAL development with Supabase CLI:
#   Run: cd infra/supabase && supabase start
#   Then: supabase status (to get the values below)
#
# Local defaults (from supabase start):
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# For PRODUCTION (Supabase hosted):
# EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key

# =============================================================================
# Environment
# =============================================================================
EXPO_PUBLIC_ENV=development

# =============================================================================
# SECURITY NOTES
# =============================================================================
# - The anon key is safe to expose in the mobile app (it's public)
# - NEVER use the service_role key in the mobile app
# - All sensitive operations go through the backend API
# - User authentication is handled by Supabase Auth
